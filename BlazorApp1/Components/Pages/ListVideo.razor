<h3>ListVideo</h3>
@page "/Videos"


@inject NavigationManager UriHelper

@inject MultimediaHeaderHttpService MultiHeader
@inject MultimediaHeaderChapterHttpService MultiHeaderChapter
@inject MultimediaChapterDetailHttpService MultiChapterDetail
@inject MultiCountryHttpService MultiCountry
@inject MultiLocationHttpService MultiLocation
@inject MultiGenreHttpService MultiGenre


<div class="col-lg-12 control-section">
    @* Initialization of ListView component with template customization *@
    <SfListView  DataSource="@loadAllVideo"
                ShowHeader="true"
                HeaderTitle="Syncfusion Blog"
                CssClass="e-list-template listview-template">
        <ListViewFieldSettings TValue="ModelTileView" Id="Id" Text="Test1" Child="Child" Tooltip="Test1" ></ListViewFieldSettings> 

        <ListViewTemplates TValue="ModelTileView">
           
            <Template>
                @{
                    var isChild = context.Child == null || context.Child.Count == 0;
                    <div class="@(context.NamePersian != null ? "clearfix desc e-list-wrapper e-list-multi-line e-list-avatar" : "clearfix e-list-wrapper e-list-multi-line e-list-avatar")">
                       @if (!isChild)
                       {
                          
                           <div class="grid-container">
                               <div class="image-box">
                                   <img src="http://192.168.1.160:1212/api/MultimediaHeader/GetImage2"
                                        alt="تصویر"
                                        width="170" height="225"
                                        onload="console.log('تصویر لود شد')"
                                        onerror="console.error('تصویر پیدا نشد')" />
                               </div>

                               <div class="info-box div2">@context.NamePersian</div>
                               <div class="info-box div3">@context.MultimediaGroup @context.Country </div>
                               <div class="info-box div4">@context.Gener</div>
                           </div>

                         

                           // @if (context.NamePersian != string.Empty)
                           // {

                           //     <img src="http://192.168.1.160:1212/api/MultimediaHeader/GetImage2"
                           //          alt="خطای تصویر"
                           //          width="170" height="225"
                           //          onload="console.log('تصویر لود شد')"
                           //          onerror="console.error('تصویر پیدا نشد')"/>

                           // }

                           // <span class="e-list-item-header">@context.NamePersian</span>
                           // <span class="e-list-content e-text-overflow">@context.Gener</span>
                           // @if (context.NamePersian != string.Empty)
                           // {
                           //     <div id="list-logo" onclick="event.stopPropagation();">
                           //         <span class="bookmark" title="We can customize this element to perform our own action"></span>
                           //         <span class="comments" title="We can customize this element to perform our own action"></span>
                           //         <span class="share" title="We can customize this element to perform our own action"></span>
                           //     </div>
                           // }

                           // @if (context.NamePersian != string.Empty)
                           // {
                           //     <div class="timeStamp">@context.MultimediaGroup</div>
                           //     <div class="timeStamp">@context.Country</div>
                           // }
                       }
                       else
                       {
                           <div>@context.NamePersian</div>
                       }
</div>}
            </Template>
        </ListViewTemplates>
    </SfListView>
</div>


@code {

 
    public class ModelTileView
    {
        public Guid Id { get; set; }
        public string NamePersian { get; set; }
        public Guid? LocationId { get; set; }
        public string Location { get; set; }
        public string Country { get; set; }
        public long Num { get; set; }
        public string MultimediaGroup { get; set; } // سینمایی | سریال
        public string Gener { get; set; }

        #region مخصوص قسمت فیلم ها

        public int ChapterCode { get; set; } // فصل
        public int ChapterFa { get; set; } // قسمت دوبله
        public int ChapterEn { get; set; } // قسمت زیر نویس  
   

        #endregion

        public List<ModelTileView> Child { get; set; } 

        //  public Image Image { get; set; }
    }
    List<ModelTileView> loadAllVideo=new List<ModelTileView>();

    private bool _firstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_firstRender)
        {
            _firstRender = false;
            await GetHeader();
            StateHasChanged(); // باعث می‌شه لیست دوباره رندر بشه
        }
    }

    // protected override void OnAfterRender(bool firstRender)
    // {
    //      GetHeader();
    //     base.OnAfterRender(firstRender);
    // }

    // protected override async Task<Task> OnAfterRenderAsync(bool firstRender)
    // {
    //     await GetHeader();
    //     return base.OnAfterRenderAsync(firstRender);
    // }

    public async Task GetHeader()
    {
        var getdata = await MultiHeader.GetByModel();
        var getlocation = await MultiLocation.GetAsync();
        var getCountry = await MultiCountry.GetAsync();
        var getGenre = await MultiGenre.GetAsync();

        loadAllVideo = getdata.Select(s =>
        {
            //  var location = Path.Combine(getlocation.First(f => f.Id == s.LocationId).DirShare_PCIP, s.Num.ToString(), "Image.jpg");
            var getgenerList = s.MultiGenreLists.Split(',');
            var genreTitles = getGenre
                .Where(g => getgenerList.Contains(g.Id.ToString()))
                .Select(g => g.Title);
            return new ModelTileView
            {
                Id = s.Id,
                NamePersian = s.NamePersian,
                LocationId = s.LocationId,
                // Location = location,
                Country = getCountry.First(f => f.Id == s.CountryId).Title,
                Num = s.Num,
                MultimediaGroup = s.MultimediaGroupId == Guid.Parse("6509e3d3-ee0f-4dac-ad65-446be213d9ef") ? "سریال" : "سینمایی",
                Gener = string.Join(',', genreTitles),
                Child = new List<ModelTileView>
                {
                    new ModelTileView{NamePersian = "توضیحات"},
                    new ModelTileView{NamePersian = "2 توضیحات"},
                }
                //  Image = Image.FromFile(location)

            };
        }).ToList();
        // dgvVideo.DataSource = loadAllVideo;

    }
}


<style>
#<!-- #region name -->
    .parent {
        direction: ltr;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-template-rows: repeat(4, 1fr);
        grid-column-gap: 0px;
        grid-row-gap: 0px;
    }

    .div1 {
        grid-area: 1 / 4 / 5 / 8;
    }

    .div2 {
        grid-area: 1 / 1 / 2 / 4;
    }

    .div3 {
        grid-area: 2 / 1 / 3 / 4;
    }

    .div4 {
        grid-area: 3 / 1 / 4 / 4;
    }

    .div5 {
        grid-area: 4 / 1 / 5 / 4;
    }
    .grid-container {
    display: grid;
    grid-template-columns: 3fr 2fr; /* سمت چپ اطلاعات، سمت راست تصویر */
    grid-template-rows: auto auto auto;
    gap: 1px;
    align-items: start;
    height: 200px;
    direction: ltr; /* برای چیدمان راست‌به‌چپ */
}

.image-box {
    grid-row: 1 / 4; /* تصویر کل ارتفاع رو بگیره */
    grid-column: 2 / 3;
    /* background-color: #f0f0f0; */
    padding: 5px;
    box-shadow: 0 0 5px rgba(0,0,0,0.2);
}

.info-box {
    grid-column: 1 / 2;
    /* background-color: #e0f7fa; */
    padding: 10px;
    border-radius: 5px;
    font-family: sans-serif;
    font-size: 14px;
}

<!-- #endregion -->
