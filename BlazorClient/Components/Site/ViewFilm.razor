
@using Bit.BlazorUI
@inject MultimediaHeaderHttpService MultiHeader
@inject MultimediaHeaderChapterHttpService MultiHeaderChapter
@inject MultimediaChapterDetailHttpService MultiChapterDetail
@inject MultiCountryHttpService MultiCountry
@inject MultiLocationHttpService MultiLocation
@inject MultiGenreHttpService MultiGenre

 @rendermode InteractiveServer 

@if ( loadAllVideo?.Any() == true)
{

    <BitSwiper  Dir="BitDir.Rtl" AnimationDuration="0.5" ScrollItemsCount="3" >
        @for (int i = 0; i < loadAllVideo.Count; i++)
        {
          
      
            var i1 = i;

            <BitSwiperItem Class="item" @onclick="() => ShowEpisodes(loadAllVideo[i1].Id)">
                <div>@loadAllVideo[i1].NamePersian</div>
                <div class="number">@i1</div>
                 <img class="image" src="@loadAllVideo[i1].UriImage" /> 
            </BitSwiperItem>
        }
    </BitSwiper>



