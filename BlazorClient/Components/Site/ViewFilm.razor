    //     }

    //     return base.OnAfterRenderAsync(false);
    // }

    public async Task GetHeader()
    {
        var getdata = await MultiHeader.GetByModel();
        var getlocation = await MultiLocation.GetAsync();
        var getCountry = await MultiCountry.GetAsync();
        var getGenre = await MultiGenre.GetAsync();

        var tasks = getdata.Select(async s =>
        {
            var getgenerList = s.MultiGenreLists.Split(',');
            var genreTitles = getGenre
                .Where(g => getgenerList.Contains(g.Id.ToString()))
                .Select(g => g.Title);

            //  var image = await MultiHeader.Image(s.Id);
            return new ModelTileView
            {
                Id = s.Id,
                NamePersian = s.NamePersian,
                LocationId = s.LocationId,
                Country = getCountry.First(f => f.Id == s.CountryId).Title,
                Num = s.Num,
                MultimediaGroup = s.MultimediaGroupId == Guid.Parse("6509e3d3-ee0f-4dac-ad65-446be213d9ef") ? "سریال" : "سینمایی",
                Gener = string.Join(',', genreTitles),
                UriImage = $"http://192.168.1.160:1212/api/MultimediaHeader/Image/{s.Id}"
            };
        });

        loadAllVideo = (await Task.WhenAll(tasks)).ToList();

        // dgvVideo.DataSource = loadAllVideo;

    }
    public class ModelTileView
    {
        public Guid Id { get; set; }
        public string NamePersian { get; set; }
        public Guid? LocationId { get; set; }
        public string Location { get; set; }
        public string Country { get; set; }
        public long Num { get; set; }
        public string MultimediaGroup { get; set; } // سینمایی | سریال
        public string Gener { get; set; }
        public string UriImage { get; set; }

    }
    List<ModelTileView> loadAllVideo = new List<ModelTileView>();

    private bool _firstRender = true;

}
