    IEnumerable<ModelChapterDetailsFull> getLocationFa;
    private async Task OnChapterChanged(string newValue)
    {
        selectedChapter = newValue;
        var getData = await MultiChapterDetail.GetByHeaderChapter(Guid.Parse(selectedChapter));

        var getData2 = getData.Select(s => new ModelGuidFaEn { ChapterDetailId = s.Id, Type = $"Fa-{s.Code}" }).ToList();
        var getCheckLocationFa = await MultiChapterDetail.GetByHeaderTranslate(getData2);
        var getCheckAddress = getCheckLocationFa.Select(s =>
        {
            var strings = Directory.GetFiles(Path.GetDirectoryName(s.AddressFile));
            var value = $"Fa-{s.ChapterCode}";
            if (strings.Any(w2 => w2.Contains(value)))
            {
                var getCheck = strings.First(w2 => w2.Contains(value));
                // return getCheck;
                return new
                {
                    Id = s.ChapterDetailsId,
                    FilePath = getCheck,
                    ChapterCode = s.ChapterCode,
                };
            }

            return null;
        }).Where(w => w != null).ToList();



        getDetailChapter = getCheckAddress.OrderByDescending(o => o.ChapterCode).Select(s => new ModelChapterDetailForVideo
        {
            Id = s.Id,
            Code = s.ChapterCode,
            Address = s.FilePath
        }).ToList();
        StateHasChanged();





        // اینجا هر اکشنی خواستی انجام بده
        await Task.CompletedTask;
    }
}







