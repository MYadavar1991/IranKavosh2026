@* <div>@usageReport</div>  *@

<BitDialog @bind-IsOpen="@IsOpen2" ShowCloseButton="true" IsBlocking="true" Dir="BitDir.Rtl" class="fullscreen-dialog">
    <div class="dialog-title">
    </div>

    <BitDropdown Label="انتخاب فصل"
                 Items="GetChapters"
                 Placeholder="Select an item"
                 TItem="BitDropdownItem<string>"
                 TValue="string"
                 Value="selectedChapter"
                 ValueChanged="OnChapterChanged" />



    <div class="dialog-body">
        <BitBasicList Items="getDetailChapter" class="dynamic-episode-list">
            <RowTemplate Context="chapter">
                <div class="episode-item">
                    <BitLabel>قسمت @chapter.Code</BitLabel>
                    <div class="episode-actions">
                        <BitButton Title="دانلود" OnClick="() => BtnDownload(Guid.NewGuid())">دانلود</BitButton>
                        <BitButton Title="پخش" OnClick="() => BtnPlay(chapter.Address)">پخش</BitButton>
                    </div>
                </div>

            </RowTemplate>
        </BitBasicList>
    </div>



</BitDialog>




<BitDialog @bind-IsOpen="IsVideoOpen"
           IsBlocking="true"
           ShowCloseButton="true"
           class="video-dialog">

    <div class="video-container">
