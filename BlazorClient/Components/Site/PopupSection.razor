    private List<BitDropdownItem<string>> GetChapters;
    List<ModelChapterDetailForVideo> getDetailChapter = new List<ModelChapterDetailForVideo>();

    

    protected override async Task OnParametersSetAsync()
    {
       
            selectedChapter = null;
            getDetailChapter.Clear();
            GetChapters?.Clear();
        

        var getChapters = await MultiHeaderChapter.GetHeaderChapter(HeaderId);

        GetChapters = getChapters.OrderByDescending(o => o.Code).Select(c => new BitDropdownItem<string>
        {
            Text = "فصل: " + c.Code.ToString(),
            Value = c.Id.ToString()
        }).ToList();

        StateHasChanged();
        // await base.OnAfterRenderAsync(firstRender);
        await base.OnParametersSetAsync();
    }
